{
  "name": "revert",
  "version": "0.1.0",
  "private": true,
  "description": "REVERT — Programmable crypto payment recovery and evidence-based conditional settlement protocol for Telegraph Hackathon Season II",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "format:write": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "node scripts/run-forge.mjs test -vv",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test && npm run test:contracts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
