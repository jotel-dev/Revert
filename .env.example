# ==============================================================================
# REVERT Local Environment Configuration (NEVER commit real .env files)
# ==============================================================================

# Network: Ethereum Sepolia (Chain ID 11155111)
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Contracts (Ethereum Sepolia)
REVERT_ESCROW_ADDRESS=
SUPPORTED_USDC_ADDRESS=0xcc194e1a843B658526D0D5C431f670028582Ae17
TELEGRAPH_DIAMOND_ADDRESS=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b

# Telegraph Node
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_PAYMENT_RAIL=escrow

# Spending Controls (6-decimal uUSDC: 10000 = 0.01 USDC)
MAX_PER_REQUEST_UUSDC=100000
MAX_TOTAL_BUDGET_UUSDC=2000000

# Isolated Server-Side Keys (configure locally only; never commit or share)
# Separate disposable test wallets recommended:
# - DEPLOYER_PRIVATE_KEY: contract deployment & admin allowlist setup
# - TELEGRAPH_PAYER_PRIVATE_KEY: funds & signs Telegraph escrow requests
# - ATTESTOR_PRIVATE_KEY: signs EIP-712 SettlementAttestation for Mode B
DEPLOYER_PRIVATE_KEY=
TELEGRAPH_PAYER_PRIVATE_KEY=
ATTESTOR_PRIVATE_KEY=

# Fastify API Server
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
